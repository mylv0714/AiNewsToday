---
import EditionLayout from '../../layouts/EditionLayout.astro'
import ThemeToggle from '../../components/ThemeToggle.astro'
import { listEditionDates } from '../../lib/editions'
import { formatKoreanDate, withBase } from '../../lib/format'

const dates = listEditionDates()
const base = import.meta.env.BASE_URL
---

<EditionLayout title="지난 판 · Morning Brief">
  <main class="page">
    <header class="masthead">
      <p class="brand">Morning Brief</p>
      <ThemeToggle />
      <h1 class="date">지난 판</h1>
      <span class="edition-meta">날짜를 고르면 그날의 닫힌 판이 열립니다.</span>
    </header>
    <ul class="archive-list">
      {
        dates.map((date) => (
          <li>
            <a href={withBase(`archive/${date}/`, base)}>{formatKoreanDate(date)}</a>
          </li>
        ))
      }
    </ul>
    <p class="back-link">
      <a href={base}>오늘 판으로</a>
    </p>
  </main>
</EditionLayout>
