---
import type { BriefItem } from '../lib/schema'
import BriefItem from './BriefItem.astro'

interface Props {
  items: BriefItem[]
  editionDate: string
}

const { items, editionDate } = Astro.props
---

{
  items.length > 0 && (
    <section class="section" aria-labelledby="overnight-label">
      <h2 class="section-label" id="overnight-label">당신이 자는 동안</h2>
      {items.map((item) => (
        <BriefItem item={item} editionDate={editionDate} />
      ))}
    </section>
  )
}
